{
  "functions": {
    "app/flask_backend.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "builds": [
    {
      "src": "app/flask_backend.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "excludeFiles": [
          "app/__pycache__/**",
          "**/__pycache__/**",
          "**/*.pyc",
          ".git/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/app.html",
      "dest": "/app/app.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/app/flask_backend.py"
    },
    {
      "src": "/(.*)",
      "dest": "/app/flask_backend.py"
    }
  ]
}